# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kathmandu

# Admin panel
# Required in production. Sign in at /admin/login with an allowlisted email plus this passcode.
ADMIN_PASSCODE=

# Shop data file
# Where products, orders and CMS content are written. Defaults to .data/store.json
STORE_DATA_FILE=

# Admin image uploads
# Where files uploaded from the admin media library are stored. Defaults to .data/uploads
UPLOADS_DIR=

# Database
DATABASE_URL=
# Persistence: set DATABASE_URL (free Neon/Supabase, use the pooled connection
# string, e.g. ?sslmode=require&pgbouncer=true). Leave blank locally to use .data/store.json.
# The store_state table is created automatically on first use.
# DIRECT_URL is no longer used by the app.

# Authentication
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (order confirmations, status updates, abandoned-bag reminders, gift cards)
# Works with any Resend-compatible HTTP endpoint. Leave blank to keep email disabled.
EMAIL_FROM=
RESEND_API_KEY=
EMAIL_REPLY_TO=

# Daily maintenance job (stock release, reconciliation, reminders, backups)
# Vercel Cron sends: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Error monitoring webhook (Slack/Discord/collector). Errors are also stored for
# /admin/system. Optional.
ERROR_WEBHOOK_URL=

# Set to 1 only to disable abuse protection while load-testing locally.
RATE_LIMIT_DISABLED=

# SMS provider (Nepal-supported provider)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# WhatsApp Business Platform
# Free tier. Used for order notifications instead of paid SMS. Leave blank to disable.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Object storage (Cloudflare R2 / S3 compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# Redis / rate limiting
REDIS_URL=

# eSewa
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_ENV=sandbox

# Khalti
KHALTI_SECRET_KEY=
KHALTI_ENV=sandbox

# Fonepay (signed redirect + server-to-server verification)
FONEPAY_MERCHANT_ID=
FONEPAY_SECRET_KEY=
FONEPAY_ENV=sandbox
# Optional overrides: FONEPAY_PG_URL and FONEPAY_RETURN_URL
# FONEPAY_RETURN_URL must be publicly reachable by Fonepay (use a tunnel locally).

# Live gateway switch
# Keep "false" until the Fonepay sandbox flow is verified end to end.
# While false, missing onboarding shows as "Coming soon" instead of taking money.
PAYMENTS_ALLOW_LIVE=false

# Firebase Client SDK (optional fallback when firebase-applet-config.json is absent)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Analytics / monitoring (optional)
NEXT_PUBLIC_GA_ID=
SENTRY_DSN=