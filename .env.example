# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kathmandu

# Admin panel
# Required in production. Sign in at /admin/login with an allowlisted email plus this passcode.
ADMIN_PASSCODE=

# Shop data file
# Where products, orders and CMS content are written. Defaults to .data/store.json
STORE_DATA_FILE=

# Database
DATABASE_URL=
DIRECT_URL=

# Authentication
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
EMAIL_FROM=
RESEND_API_KEY=

# SMS provider (Nepal-supported provider)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# WhatsApp Business Platform
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Object storage (Cloudflare R2 / S3 compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# Redis / rate limiting
REDIS_URL=

# eSewa
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_ENV=sandbox

# Khalti
KHALTI_SECRET_KEY=
KHALTI_ENV=sandbox

# Fonepay
FONEPAY_MERCHANT_ID=
FONEPAY_SECRET_KEY=
FONEPAY_ENV=sandbox

# Firebase Client SDK (optional fallback when firebase-applet-config.json is absent)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Analytics / monitoring (optional)
NEXT_PUBLIC_GA_ID=
SENTRY_DSN=