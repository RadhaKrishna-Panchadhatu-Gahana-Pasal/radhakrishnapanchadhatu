// Radha Krishna Panchha Dhatu - Prisma Schema
// Database: PostgreSQL
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  CONTENT_EDITOR
  ORDER_STAFF
  MANAGER
  OWNER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductType {
  READY_STOCK
  MADE_TO_ORDER
  CUSTOM_ORDER
}

enum OrderFulfilmentStatus {
  ORDER_PLACED
  ORDER_RECEIVED
  PROCESSING
  READY_TO_DISPATCH
  DISPATCHED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  INITIATED
  PROCESSING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
  MANUAL_REVIEW
}

enum PaymentProvider {
  ESEWA
  KHALTI
  FONEPAY
  CASH_ON_DELIVERY
  MANUAL
}

enum ReviewModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum CustomOrderStatus {
  RECEIVED
  REVIEWING
  QUOTED
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum StockMovementReason {
  PURCHASE
  SALE
  RETURN
  MANUAL_ADJUSTMENT
  DAMAGE
  INITIAL_STOCK
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  phoneVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  addresses           Address[]
  carts               Cart[]
  orders              Order[]
  reviews             Review[]
  customOrderRequests CustomOrderRequest[]
  auditLogs           AdminAuditLog[]
  inventoryMovements  InventoryMovement[]
  mediaAssets         MediaAsset[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// ADDRESS
// ─────────────────────────────────────────────────────────────────────────────

model Address {
  id           String   @id @default(cuid())
  userId       String?
  recipient    String
  phone        String
  province     String
  district     String
  municipality String
  ward         String?
  street       String?
  landmark     String?
  notes        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders Order[]

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CATALOGUE
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  imageAlt    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  imageAlt    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products CollectionProduct[]

  @@index([slug])
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Product {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  sku                String        @unique
  shortDescription   String?
  description        String?       @db.Text
  material           String?
  categoryId         String?
  price              Int           // paisa (1 NPR = 100 paisa)
  compareAtPrice     Int?
  salePriceAmount    Int?
  saleStartsAt       DateTime?
  saleEndsAt         DateTime?
  stock              Int           @default(0)
  lowStockThreshold  Int           @default(5)
  status             ProductStatus @default(DRAFT)
  productType        ProductType   @default(READY_STOCK)
  isFeatured         Boolean       @default(false)
  isNewArrival       Boolean       @default(false)
  newArrivalExpiresAt DateTime?
  isBestSeller       Boolean       @default(false)
  weight             Float?
  careInstructions   String?
  deliveryNote       String?
  tags               String[]
  seoTitle           String?
  seoDesc            String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]
  images      ProductImage[]
  collections CollectionProduct[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  movements   InventoryMovement[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isNewArrival])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  sku        String  @unique
  attributes Json    // e.g. { "size": "7", "finish": "gold" }
  price      Int?    // override product price (paisa), null = use product price
  stock      Int     @default(0)
  isActive   Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  storageKey String
  url        String
  altText    String?
  sortOrder  Int     @default(0)
  isMain     Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model InventoryMovement {
  id        String              @id @default(cuid())
  productId String
  variantId String?
  delta     Int                 // positive = stock in, negative = stock out
  reason    StockMovementReason
  note      String?
  actorId   String?
  createdAt DateTime            @default(now())

  product Product @relation(fields: [productId], references: [id])
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CART
// ─────────────────────────────────────────────────────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String?
  guestToken String?    @unique
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([guestToken])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  addedAt   DateTime @default(now())

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id                String                @id @default(cuid())
  orderNumber       String                @unique
  userId            String?
  guestName         String?
  guestEmail        String?
  guestPhone        String?
  trackingToken     String                @unique @default(cuid())
  fulfilmentStatus  OrderFulfilmentStatus @default(ORDER_PLACED)
  paymentStatus     PaymentStatus         @default(PENDING)
  subtotal          Int                   // paisa
  discountAmount    Int                   @default(0)
  deliveryFee       Int                   @default(0)
  total             Int                   // paisa
  currency          String                @default("NPR")
  couponCode        String?
  deliveryNote      String?
  courierName       String?
  trackingNumber    String?
  dispatchedAt      DateTime?
  deliveredAt       DateTime?
  cancelReason      String?
  internalNote      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveryAddress OrderAddress?
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]

  @@index([orderNumber])
  @@index([userId])
  @@index([trackingToken])
  @@index([fulfilmentStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderAddress {
  id           String @id @default(cuid())
  orderId      String @unique
  recipient    String
  phone        String
  province     String
  district     String
  municipality String
  ward         String?
  street       String?
  landmark     String?
  notes        String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  address Address? @relation(fields: [addressId], references: [id])
  addressId String?
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String?
  variantId       String?
  productName     String  // snapshot
  variantLabel    String? // snapshot
  sku             String  // snapshot
  unitPrice       Int     // paisa snapshot
  quantity        Int
  subtotal        Int     // paisa

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusHistory {
  id             String                @id @default(cuid())
  orderId        String
  fromStatus     OrderFulfilmentStatus?
  toStatus       OrderFulfilmentStatus
  publicNote     String?
  internalNote   String?
  actorId        String?
  actorName      String?
  createdAt      DateTime              @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  amount            Int             // paisa
  currency          String          @default("NPR")
  status            PaymentStatus   @default(PENDING)
  providerReference String?         // provider's transaction ID
  providerResponse  Json?
  idempotencyKey    String          @unique @default(cuid())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order   Order          @relation(fields: [orderId], references: [id])
  events  PaymentEvent[]
  refunds Refund[]

  @@index([orderId])
  @@index([provider])
  @@index([status])
  @@index([providerReference])
}

model PaymentEvent {
  id          String   @id @default(cuid())
  paymentId   String
  eventType   String
  payload     Json?
  processedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Refund {
  id                String   @id @default(cuid())
  paymentId         String
  amount            Int      // paisa
  reason            String?
  status            String   @default("PENDING")
  providerReference String?
  createdAt         DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id               String                 @id @default(cuid())
  userId           String
  productId        String
  orderItemId      String?
  rating           Int                    // 1-5
  title            String?
  content          String?                @db.Text
  images           String[]
  isVerifiedPurchase Boolean              @default(false)
  moderationStatus ReviewModerationStatus @default(PENDING)
  adminReply       String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([moderationStatus])
}

// ─────────────────────────────────────────────────────────────────────────────
// CMS
// ─────────────────────────────────────────────────────────────────────────────

model Banner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  desktopImage String
  mobileImage String?
  imageAlt    String?
  ctaLabel    String?
  ctaUrl      String?
  isEnabled   Boolean   @default(true)
  sortOrder   Int       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Announcement {
  id          String    @id @default(cuid())
  message     String
  linkText    String?
  linkUrl     String?
  bgColor     String    @default("#B08A45")
  textColor   String    @default("#FFFFFF")
  isEnabled   Boolean   @default(true)
  isScrolling Boolean   @default(true)
  isDismissible Boolean @default(false)
  sortOrder   Int       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model HomepageSection {
  id        String   @id @default(cuid())
  type      String   // e.g. HERO, CATEGORIES, NEW_ARRIVALS, FEATURED, etc.
  title     String?
  subtitle  String?
  content   Json?
  isEnabled Boolean  @default(true)
  sortOrder Int      @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  isDraft   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model Page {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String?   @db.Text
  seoTitle    String?
  seoDesc     String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model MediaAsset {
  id           String   @id @default(cuid())
  storageKey   String   @unique
  url          String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    // PERCENTAGE or FIXED
  discountValue Int       // paisa for FIXED, basis points (e.g. 1000 = 10%) for PERCENTAGE
  minOrderValue Int?
  maxUses       Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([code])
}

model CustomOrderRequest {
  id          String            @id @default(cuid())
  userId      String?
  name        String
  phone       String
  description String?           @db.Text
  referenceImages String[]
  status      CustomOrderStatus @default(RECEIVED)
  adminNote   String?
  whatsappRef String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
}

model NotificationLog {
  id         String              @id @default(cuid())
  channel    NotificationChannel
  recipient  String
  templateId String?
  subject    String?
  body       String?             @db.Text
  providerId String?
  status     String              @default("PENDING")
  error      String?
  createdAt  DateTime            @default(now())

  @@index([recipient])
  @@index([status])
}

model StoreSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorName   String?
  action      String
  entityType  String?
  entityId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
